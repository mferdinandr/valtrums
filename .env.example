# NEAR
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
ARENA_CONTRACT_ID=
ROUTER_CONTRACT_ID=
USDC_CONTRACT_ID=

# Agent (never commit real values)
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=

# External APIs
DEXSCREENER_API_KEY=

# Lifecycle audit (GoPlus + liquidity). Off unless AUDIT_ENABLED=true. Never commit real values.
AUDIT_ENABLED=
# Lets the agent send lock_lifecycle_battle once every community is approved and fresh. Off unless true; a lock is final.
AUDIT_LOCK_ENABLED=
# Evidence TTL in seconds (default 600; must exceed twice AGENT_INTERVAL_SECS)
AUDIT_EVIDENCE_TTL_SECS=
# Read-only Robinhood mainnet (4663) RPC for reference-token liquidity; https only (http for localhost). Separate from FOREIGN_RPC_URL.
REFERENCE_RPC_URL=
# Reference mappings come only from the arena's on-chain registry (owner: add_reference_entry).
# AUDIT_REFERENCE_REGISTRY was removed; startup fails if it is set.
# Explicit stablecoin list on 4663 (1 unit = 1 USD; decimals are re-checked on-chain): {"0xaddress": decimals}
# Example (USDG, verified on-chain 2026-11-08: "Global Dollar", 6 decimals, upgradeable proxy): {"0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168": 6}
AUDIT_STABLECOINS=
# Pools to read on 4663 (value = quote-side balance only): [{"pool":"0x..","kind":"v2"}] (kind v2 or v3)
AUDIT_LP_POOLS=
# WETH pricing (all optional; unset leaves WETH-quoted pools unpriced and Pending). No defaults exist in code.
# Example values, verified on-chain 2026-11-08 (two RPC providers, same block; see docs/evidence/2026-11-08-arena-audit-verification.json):
#   AUDIT_WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
#   AUDIT_WETH_CHAIN_ID=4663
#   AUDIT_WETH_PRICE_POOL=0x52e65B17fB6E5BA00Ed806f37Afcd2DaA50271Ca   (Uniswap v3 WETH/USDG)
#   AUDIT_WETH_PRICE_POOL_MIN_USD=1000000   (floor on the pool's stable-side balance)
AUDIT_WETH_ADDRESS=
AUDIT_WETH_CHAIN_ID=
AUDIT_WETH_PRICE_POOL=
AUDIT_WETH_PRICE_POOL_MIN_USD=
# Optional: GoPlus works without a credential (rate limited). Leave empty to send no Authorization header.
GOPLUS_ACCESS_TOKEN=

# Web app (public, browser-visible; no secrets). Leave the contract id empty to run on demo data.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_ARENA_CONTRACT_ID=
# Intent terminal (server-side only, never prefix with NEXT_PUBLIC_). Leave empty to use the rule-based parser.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=
# 1Click (NEAR Intents) funding. Enable with NEXT_PUBLIC_FUNDING_ROUTER=intents; the JWT is optional and server-side only.
ONECLICK_API_URL=https://1click.chaindefuser.com
ONECLICK_API_KEY=
NEXT_PUBLIC_FUNDING_ROUTER=mock

# Read-only MCP / terminal read API (agent: `pnpm -C agent read:serve` or `read:mcp`). It holds no private key.
# PAYOUT_CONTRACT_ID is optional (payout reads stay empty without it). AUDIT_ARCHIVE_PATH points at the audit report archive.
PAYOUT_CONTRACT_ID=
AUDIT_ARCHIVE_PATH=
# HMAC key for read session tokens: at least 32 bytes of hex (e.g. `openssl rand -hex 32`). Never commit a real value.
READ_SESSION_SECRET=
# NEP-413 recipient clients sign for when opening a read session.
READ_SESSION_RECIPIENT=valtrum-read
READ_API_HOST=127.0.0.1
READ_API_PORT=8790
# Web server-side only: where /api/arena/* forwards read tools and actions. Never prefix with NEXT_PUBLIC_.
ARENA_READ_API_URL=http://127.0.0.1:8790
# Action boundary (optional; enabled only when ACTION_STORE_PATH is set). The service still holds no key:
# the user's wallet signs. PLAYER_POLICY_CONTRACT_ID enables grant reservations; ACTION_RECIPIENT is the
# NEP-413 recipient for action approvals (defaults to READ_SESSION_RECIPIENT).
ACTION_STORE_PATH=
PLAYER_POLICY_CONTRACT_ID=
ACTION_RECIPIENT=
# Player agents (operator configuration, never model output): which grants each delegate may propose under.
# {"agent.testnet":[{"user":"alice.testnet","localId":"<32-byte hex>","mappingVersion":"2"}]}
PLAYER_AGENT_GRANTS=
