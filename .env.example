# NEAR
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
ARENA_CONTRACT_ID=
ROUTER_CONTRACT_ID=
USDC_CONTRACT_ID=

# Agent (never commit real values)
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=

# External APIs
DEXSCREENER_API_KEY=

# Lifecycle audit (GoPlus + liquidity). Off unless AUDIT_ENABLED=true. Never commit real values.
AUDIT_ENABLED=
# Evidence TTL in seconds (default 600; must exceed twice AGENT_INTERVAL_SECS)
AUDIT_EVIDENCE_TTL_SECS=
# Read-only Robinhood mainnet (4663) RPC for reference-token liquidity; https only (http for localhost). Separate from FOREIGN_RPC_URL.
REFERENCE_RPC_URL=
# Protocol-controlled mapping: [{"chain_id":"46630","token":"0x..","reference_chain_id":"4663","reference_address":"0x.."}]
AUDIT_REFERENCE_REGISTRY=
# Explicit stablecoin list on 4663 (1 unit = 1 USD; decimals are re-checked on-chain): {"0xaddress": decimals}
# Example (USDG per DexScreener, NOT verified on-chain by us): {"0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168": 6}
AUDIT_STABLECOINS=
# Pools to read on 4663 (value = quote-side balance only): [{"pool":"0x..","kind":"v2"}] (kind v2 or v3)
AUDIT_LP_POOLS=
# WETH pricing (all optional; unset leaves WETH-quoted pools unpriced and Pending). No defaults exist in code.
# Example values from DexScreener, NOT verified on-chain by us:
#   AUDIT_WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
#   AUDIT_WETH_CHAIN_ID=4663
#   AUDIT_WETH_PRICE_POOL=0x52e65B17fB6E5BA00Ed806f37Afcd2DaA50271Ca   (Uniswap v3 WETH/USDG)
#   AUDIT_WETH_PRICE_POOL_MIN_USD=1000000   (floor on the pool's stable-side balance)
AUDIT_WETH_ADDRESS=
AUDIT_WETH_CHAIN_ID=
AUDIT_WETH_PRICE_POOL=
AUDIT_WETH_PRICE_POOL_MIN_USD=
# Optional: GoPlus works without a credential (rate limited). Leave empty to send no Authorization header.
GOPLUS_ACCESS_TOKEN=

# Web app (public, browser-visible; no secrets). Leave the contract id empty to run on demo data.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_ARENA_CONTRACT_ID=
# Intent terminal (server-side only, never prefix with NEXT_PUBLIC_). Leave empty to use the rule-based parser.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=
# 1Click (NEAR Intents) funding. Enable with NEXT_PUBLIC_FUNDING_ROUTER=intents; the JWT is optional and server-side only.
ONECLICK_API_URL=https://1click.chaindefuser.com
ONECLICK_API_KEY=
NEXT_PUBLIC_FUNDING_ROUTER=mock
