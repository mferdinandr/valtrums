# NEAR
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
ARENA_CONTRACT_ID=
ROUTER_CONTRACT_ID=
USDC_CONTRACT_ID=

# Agent (never commit real values)
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=

# External APIs
DEXSCREENER_API_KEY=

# Lifecycle audit (GoPlus + liquidity). Off unless AUDIT_ENABLED=true. Never commit real values.
AUDIT_ENABLED=
# Lets the agent send lock_lifecycle_battle once the start time passed, 2+ communities are funded and every funded one is approved and fresh. Off unless true; a lock is final.
AUDIT_LOCK_ENABLED=
# Lets the agent send cancel_lifecycle_battle when the start time passed with fewer than 2 funded communities. Off unless true.
AUDIT_CANCEL_ENABLED=
# The agent keeps every community's backing approval fresh with refresh_lifecycle_backing (needs the agent account whitelisted). On unless false.
AUDIT_BACKING_REFRESH_ENABLED=
# Evidence TTL in seconds (default 600; must exceed twice AGENT_INTERVAL_SECS)
AUDIT_EVIDENCE_TTL_SECS=
# Read-only Robinhood mainnet (4663) RPC for reference-token liquidity; https only (http for localhost). Separate from FOREIGN_RPC_URL.
REFERENCE_RPC_URL=
# Reference mappings come only from the arena's on-chain registry (owner: add_reference_entry).
# AUDIT_REFERENCE_REGISTRY was removed; startup fails if it is set.
# Explicit stablecoin list on 4663 (1 unit = 1 USD; decimals are re-checked on-chain): {"0xaddress": decimals}
# Example (USDG, verified on-chain 2026-11-08: "Global Dollar", 6 decimals, upgradeable proxy): {"0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168": 6}
AUDIT_STABLECOINS=
# Pools to read on 4663 (value = quote-side balance only): [{"pool":"0x..","kind":"v2"}] (kind v2 or v3)
AUDIT_LP_POOLS=
# WETH pricing (all optional; unset leaves WETH-quoted pools unpriced and Pending). No defaults exist in code.
# Example values, verified on-chain 2026-11-08 (two RPC providers, same block; see docs/evidence/2026-11-08-arena-audit-verification.json):
#   AUDIT_WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
#   AUDIT_WETH_CHAIN_ID=4663
#   AUDIT_WETH_PRICE_POOL=0x52e65B17fB6E5BA00Ed806f37Afcd2DaA50271Ca   (Uniswap v3 WETH/USDG)
#   AUDIT_WETH_PRICE_POOL_MIN_USD=1000000   (floor on the pool's stable-side balance)
AUDIT_WETH_ADDRESS=
AUDIT_WETH_CHAIN_ID=
AUDIT_WETH_PRICE_POOL=
AUDIT_WETH_PRICE_POOL_MIN_USD=
# Optional: GoPlus works without a credential (rate limited). Leave empty to send no Authorization header.
GOPLUS_ACCESS_TOKEN=

# Web app (public, browser-visible; no secrets). Put these in web/.env.local (Next.js reads env only from web/).
# There is ONE application. The two variables below are REQUIRED: when either is missing the app shows one screen
# naming it instead of rendering anything. The deployment id must match a deployment in the agent manifest.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_ARENA_CONTRACT_ID=
NEXT_PUBLIC_ARENA_READ_DEPLOYMENT=
# Optional; the only supported value is lifecycle-v2.
NEXT_PUBLIC_ARENA_READ_PROTOCOL=lifecycle-v2
# Optional: the player-policy contract that holds agent grants (the Agents page). Same value as PLAYER_POLICY_CONTRACT_ID.
NEXT_PUBLIC_PLAYER_POLICY_CONTRACT_ID=
# Intent terminal (server-side only, never prefix with NEXT_PUBLIC_). Leave empty to use the rule-based parser.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=
# 1Click (NEAR Intents) funding. Enable with NEXT_PUBLIC_FUNDING_ROUTER=intents; the JWT is optional and server-side only.
ONECLICK_API_URL=https://1click.chaindefuser.com
ONECLICK_API_KEY=
NEXT_PUBLIC_FUNDING_ROUTER=mock

# Read-only MCP / terminal read API (agent: `pnpm -C agent read:serve` or `read:mcp`). It holds no private key.
# PAYOUT_CONTRACT_ID is optional (payout reads stay empty without it). AUDIT_ARCHIVE_PATH points at the audit report archive the agent writes (alias of the agent's AUDIT_REPORT_ARCHIVE_PATH; keep them equal).
PAYOUT_CONTRACT_ID=
AUDIT_ARCHIVE_PATH=
# HMAC key for read session tokens: at least 32 bytes of hex (e.g. `openssl rand -hex 32`). Never commit a real value.
READ_SESSION_SECRET=
# NEP-413 recipient clients sign for when opening a read session.
READ_SESSION_RECIPIENT=valtrum-read
READ_API_HOST=127.0.0.1
READ_API_PORT=8790
# Web server-side only: where /api/arena/* forwards read tools and actions. Never prefix with NEXT_PUBLIC_.
ARENA_READ_API_URL=http://127.0.0.1:8790
# Action boundary (optional; enabled only when ACTION_STORE_PATH is set). The service still holds no key:
# the user's wallet signs. PLAYER_POLICY_CONTRACT_ID enables grant reservations; ACTION_RECIPIENT is the
# NEP-413 recipient for action approvals (defaults to READ_SESSION_RECIPIENT).
ACTION_STORE_PATH=
PLAYER_POLICY_CONTRACT_ID=
ACTION_RECIPIENT=
# Player agents (operator configuration, never model output): which grants each delegate may propose under.
# {"agent.testnet":[{"user":"alice.testnet","localId":"<32-byte hex>","mappingVersion":"2"}]}
PLAYER_AGENT_GRANTS=
# Testnet only: accept the labelled `intents-fixture` funding route (a local fixture of 1Click, not NEAR Intents).
# The action service refuses to start with this set on any network but testnet. `pnpm -C agent intents:fixture` serves the fixture.
INTENTS_FIXTURE=
INTENTS_FIXTURE_PORT=8791
# Read-only path to the indexer state directory (state.json) for indexer health in recovery alerts.
INDEXER_STATE_DIR=

# Payout roles (separate processes, never share a key or an environment): `pnpm -C agent payout:relayer` / `payout:operator`.
# Shared (non-secret): PAYOUT_CONTRACT_ID, PAYOUT_EVM_RPC_URL (https), PAYOUT_CHAIN_ID, PAYOUT_INTERVAL_SECS (default 30).
# Relayer only: PAYOUT_RELAYER_ACCOUNT_ID, PAYOUT_RELAYER_PRIVATE_KEY or _FILE, PAYOUT_RELAYER_MAX_FEE_PER_GAS_WEI.
# Operator only: PAYOUT_OPERATOR_ACCOUNT_ID, PAYOUT_OPERATOR_PRIVATE_KEY or _FILE, PAYOUT_OPERATOR_SUBMIT (default false = dry run).
PAYOUT_CHAIN_ID=
PAYOUT_EVM_RPC_URL=

# Live finalized indexer (off by default; see docs/openspec/changes/arena-testnet-integrations/live-source-handoff.md).
# INDEXER_ENABLED=true
# INDEXER_SOURCE=near-data
# INDEXER_GENESIS_HEIGHT=
# INDEXER_GENESIS_HASH=
# INDEXER_PROVIDER_EVIDENCE=
# INDEXER_ANCHOR_HEIGHT=
# INDEXER_ANCHOR_HASH=

# Observation reads (off by default; see agent/README.md "Market observations"). Qualified modes come from provider qualification.
# OBSERVATION_JOURNAL_DIR=
# ARENA_APPLICATION_OBSERVATION_SCOPE={"deploymentId":"","network":"near-testnet","arenaContract":"","protocol":"lifecycle-v2"}
# OBSERVATION_QUALIFIED_MODES=
# OBSERVATION_BOUNDARY_TOLERANCE_MS=
# OBSERVATION_MAX_GAP_MS=

# Lifecycle oracle (dedicated process, dedicated key; starts in dry run). See agent/README.md "Lifecycle oracle".
# ORACLE_ACCOUNT_ID=
# ORACLE_PRIVATE_KEY=
# ORACLE_STATE_DIR=./.agent-state/oracle
# ORACLE_TERMS_PATH=
# ORACLE_EVIDENCE_KINDS=live
# ORACLE_WRITES_ENABLED=false

# Application read mode has no wallet by default. "true" mounts the wallet for signing lifecycle actions only
# (the legacy ArenaApi is still not provided). The read service must also run with actions enabled (ACTION_STORE_PATH).
# NEXT_PUBLIC_APPLICATION_WALLET=false

# Player agent program (`pnpm -C agent player:run`). Keys are named in the config file's `keyEnv` and set here or in the agent's own environment, never in the config file.
PLAYER_AGENTS_PATH=
PLAYER_ACTION_STORE_PATH=./.data/player-actions.json
PLAYER_STATE_PATH=./.data/player-state.json
# PLAYER_KEY_AGENT_A_TESTNET=ed25519:...

# Live price preview (web, server-side only, never NEXT_PUBLIC_). A reachable Robinhood mainnet (4663) RPC for /api/reference-price.
# Falls back to REFERENCE_RPC_URL; use this dedicated name so a shell-exported REFERENCE_RPC_URL cannot override web/.env.local.
PRICE_PREVIEW_RPC_URL=
# Testnet faucet contract (contracts/faucet). Read over RPC by the web app; there is no faucet server or key.
# Set it after the contract is deployed and funded (see `pnpm -C agent faucet:plan`).
NEXT_PUBLIC_FAUCET_CONTRACT_ID=
# Scoring modes a new open arena may use (comma-separated; default PriceGain). Keep it equal to the mode of the
# arena's observation policy: a battle of another mode could lock and never start its rounds.
NEXT_PUBLIC_LIFECYCLE_CREATE_MODES=PriceGain
