{
  "name": "@valtrum/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && pnpm start",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "indexer:import": "node dist/indexer/cli.js import",
    "indexer:status": "node dist/indexer/cli.js status",
    "indexer:replay": "node dist/indexer/cli.js replay",
    "indexer:projection": "node dist/indexer/cli.js projection"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "near-kit": "^0.20.2"
  }
}
