{
  "name": "@valtrum/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && node --env-file-if-exists=.env.local dist/mcp/cli.js http",
    "dev:settle": "pnpm build && node --env-file-if-exists=.env.local dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "indexer:import": "node dist/indexer/cli.js import",
    "indexer:status": "node dist/indexer/cli.js status",
    "indexer:replay": "node dist/indexer/cli.js replay",
    "indexer:projection": "node dist/indexer/cli.js projection",
    "audit:report:serve": "node dist/audit/report-cli.js serve",
    "audit:report:list": "node dist/audit/report-cli.js list",
    "audit:report:get": "node dist/audit/report-cli.js get",
    "audit:report:seed-demo": "node dist/audit/report-cli.js seed-demo",
    "lifecycle:oracle": "node dist/lifecycle-oracle/main.js",
    "payout:relayer": "node dist/payout-role-main.js relayer",
    "payout:operator": "node dist/payout-role-main.js operator",
    "read:mcp": "node dist/mcp/cli.js mcp",
    "read:serve": "node dist/mcp/cli.js http",
    "faucet:serve": "pnpm build && node --env-file-if-exists=.env.local dist/faucet/cli.js",
    "faucet:plan": "pnpm build && node dist/faucet/funding-plan-cli.js",
    "player:run": "node --env-file-if-exists=.env.local dist/player/cli.js",
    "intents:fixture": "node dist/intents-fixture/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/hashes": "^2.4.0",
    "near-kit": "^0.20.2",
    "zod": "^4.6.7"
  }
}
