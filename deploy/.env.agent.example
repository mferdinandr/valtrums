# Copy to deploy/.env.agent. Never commit the filled-in file.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
ARENA_CONTRACT_ID=
AGENT_ACCOUNT_ID=

# Secret: set exactly one of these two.
AGENT_PRIVATE_KEY=
# AGENT_PRIVATE_KEY_FILE=/run/secrets/agent_key

DEXSCREENER_API_KEY=

EXECUTION_MODE=mock
HEALTH_PORT=8080

# Published by /attestation. Set it to the digest of the image you deploy.
IMAGE_DIGEST=
